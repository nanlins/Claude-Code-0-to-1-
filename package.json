  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.3",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

